{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eps.dev/schemas/sale-snapshot.v1.json",
  "title": "SaleSnapshot",
  "description": "An immutable sale snapshot (schemaVersion 1, design D3.2): the products, pools, prices and rules one publish fixed for one event. Money in integer minor units; allInMinor = faceMinor + fanFeeMinor on every price step.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "organiserId",
    "brandId",
    "eventId",
    "version",
    "publishedAt",
    "currency",
    "timezone",
    "isSample",
    "fee",
    "event",
    "rules",
    "pools",
    "products"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "snapshotId": {
      "$ref": "#/$defs/uuid"
    },
    "organiserId": {
      "$ref": "#/$defs/uuid"
    },
    "brandId": {
      "$ref": "#/$defs/uuid"
    },
    "eventId": {
      "$ref": "#/$defs/uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "currency": {
      "type": "string",
      "enum": [
        "RON",
        "EUR"
      ]
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "isSample": {
      "type": "boolean"
    },
    "fee": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "bps",
        "fixedMinor"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "absorb",
            "pass_on",
            "split"
          ]
        },
        "bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "fixedMinor": {
          "$ref": "#/$defs/minor"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "name",
        "description",
        "startsAt",
        "endsAt",
        "timezone",
        "venue",
        "days",
        "lineup"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,58}[a-z0-9]$"
        },
        "name": {
          "$ref": "#/$defs/l10n"
        },
        "description": {
          "$ref": "#/$defs/l10n"
        },
        "startsAt": {
          "type": "string",
          "format": "date-time"
        },
        "endsAt": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "venue": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "address",
                "lat",
                "lng"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "address": {
                  "type": "string"
                },
                "lat": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": -90,
                  "maximum": 90
                },
                "lng": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": -180,
                  "maximum": 180
                }
              }
            }
          ]
        },
        "days": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "opens",
              "closes"
            ],
            "properties": {
              "date": {
                "$ref": "#/$defs/date"
              },
              "opens": {
                "$ref": "#/$defs/time"
              },
              "closes": {
                "$ref": "#/$defs/time"
              }
            }
          }
        },
        "lineup": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "artist",
              "stage",
              "starts",
              "sample"
            ],
            "properties": {
              "date": {
                "$ref": "#/$defs/date"
              },
              "artist": {
                "type": "string"
              },
              "stage": {
                "type": "string"
              },
              "starts": {
                "$ref": "#/$defs/time"
              },
              "sample": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minAge",
        "consentUnderAge",
        "maxPerAccount",
        "holdMinutes",
        "checkoutQuestions"
      ],
      "properties": {
        "minAge": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 99
        },
        "consentUnderAge": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 99
        },
        "maxPerAccount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "holdMinutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 15,
          "description": "Checkout hold length in minutes (default 8)."
        },
        "checkoutQuestions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "afterContact",
            "consents"
          ],
          "description": "The shop's checkout slots (storefront document checkout.slots) at publish: question and consent ids, in order.",
          "properties": {
            "afterContact": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              }
            },
            "consents": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              }
            }
          }
        }
      }
    },
    "pools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "poolId",
          "name",
          "scope",
          "instances"
        ],
        "properties": {
          "poolId": {
            "$ref": "#/$defs/uuid"
          },
          "name": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "event",
              "day",
              "slot"
            ]
          },
          "instances": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "instanceId",
                "date",
                "slotStart",
                "capacity"
              ],
              "properties": {
                "instanceId": {
                  "type": "string",
                  "pattern": "^[0-9a-f-]{36}(@[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2})?)?$"
                },
                "date": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "slotStart": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "capacity": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productId",
          "type",
          "name",
          "perks",
          "zone",
          "config",
          "named",
          "salesFrom",
          "salesUntil",
          "visible",
          "maxPerOrder",
          "sortOrder",
          "poolIds",
          "requires",
          "priceSteps",
          "instalments"
        ],
        "properties": {
          "productId": {
            "$ref": "#/$defs/uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "pass",
              "day_ticket",
              "flex_day",
              "add_on",
              "voucher",
              "table",
              "time_slot"
            ]
          },
          "name": {
            "$ref": "#/$defs/l10n"
          },
          "perks": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/l10n"
            }
          },
          "zone": {
            "type": [
              "string",
              "null"
            ]
          },
          "config": {
            "type": "object"
          },
          "named": {
            "type": "boolean"
          },
          "salesFrom": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "salesUntil": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "visible": {
            "type": "boolean"
          },
          "maxPerOrder": {
            "type": "integer",
            "minimum": 1
          },
          "sortOrder": {
            "type": "integer"
          },
          "poolIds": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/uuid"
            }
          },
          "requires": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/uuid"
            }
          },
          "priceSteps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "index",
                "mode",
                "fromAt",
                "afterSold",
                "faceMinor",
                "allInMinor",
                "fanFeeMinor",
                "organiserNetMinor"
              ],
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "by_date",
                    "by_sales"
                  ]
                },
                "fromAt": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "afterSold": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "faceMinor": {
                  "$ref": "#/$defs/minor"
                },
                "allInMinor": {
                  "$ref": "#/$defs/minor"
                },
                "fanFeeMinor": {
                  "$ref": "#/$defs/minor"
                },
                "organiserNetMinor": {
                  "type": "integer"
                }
              }
            }
          },
          "instalments": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "depositMinor",
                  "depositBps",
                  "monthlyCount",
                  "dayOfMonth",
                  "lastDueBy"
                ],
                "properties": {
                  "depositMinor": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "depositBps": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 9999
                  },
                  "monthlyCount": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 24
                  },
                  "dayOfMonth": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 28
                  },
                  "lastDueBy": {
                    "$ref": "#/$defs/date"
                  }
                }
              }
            ]
          },
          "personaliseBy": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "checkinBy": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lateCheckin": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "faceMinor",
                  "allInMinor",
                  "fanFeeMinor",
                  "organiserNetMinor"
                ],
                "properties": {
                  "faceMinor": {
                    "$ref": "#/$defs/minor"
                  },
                  "allInMinor": {
                    "$ref": "#/$defs/minor"
                  },
                  "fanFeeMinor": {
                    "$ref": "#/$defs/minor"
                  },
                  "organiserNetMinor": {
                    "type": "integer"
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "minor": {
      "type": "integer",
      "minimum": 0
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "time": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "l10n": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ro",
        "en"
      ],
      "properties": {
        "ro": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      }
    }
  }
}

# Copy to .env.local for local development. Never commit real values.
# Neon sets DATABASE_URL and DATABASE_URL_UNPOOLED per preview through the Vercel integration.
DATABASE_URL=postgres://postgres:pw@localhost:55433/postgres?sslmode=disable
DATABASE_URL_UNPOOLED=
# At least 32 random characters; generated per Vercel environment by bootstrap-secrets.yml.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Previews and the public demo only: "on" shows "Continue as demo organiser / fan" and the demo mailbox.
EPS_DEMO_SIGNIN=on
EPS_DEMO_EMAIL_DOMAIN=demo.eps-prototype.dev
EPS_DEMO_SIGNIN_PER_MINUTE=30
EPS_MAGIC_LINK_PER_MINUTE=5
# Google sign-in appears only when both are set (owner account action).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The Go core: explicit in production, else derived from the branch and the load balancer domain.
CORE_API_URL=http://localhost:8080
CORE_BASE_DOMAIN=

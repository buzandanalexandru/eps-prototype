# Copy to .env.local for local development. Never commit real values.
# Locally: one direct connection string. On Vercel, CI sets EPS_DATABASE_URL (pooled) and
# EPS_DATABASE_URL_UNPOOLED (direct; Better Auth keeps session-level SET ROLE) as eps_web_login,
# branch-scoped on previews. A preview never falls back to the Neon-Vercel integration's
# DATABASE_URL (a copy of production with its data); production may, until CI has bound it.
DATABASE_URL=postgres://postgres:pw@localhost:55433/postgres?sslmode=disable
DATABASE_URL_UNPOOLED=
EPS_DATABASE_URL=
EPS_DATABASE_URL_UNPOOLED=
# Connections per pool per function instance (default 3).
EPS_DB_POOL_MAX=3
# At least 32 random characters; generated per Vercel environment by bootstrap-secrets.yml.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Previews and the public demo only: "on" shows "Continue as demo organiser / fan" and the demo mailbox.
EPS_DEMO_SIGNIN=on
EPS_DEMO_EMAIL_DOMAIN=demo.eps.invalid
EPS_DEMO_SIGNIN_PER_MINUTE=30
EPS_MAGIC_LINK_PER_MINUTE=5
# Google sign-in appears only when both are set (owner account action).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The Go core: explicit in production, else derived from the branch and the load balancer domain.
CORE_API_URL=http://localhost:8080
CORE_BASE_DOMAIN=
